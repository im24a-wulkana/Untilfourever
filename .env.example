# Copy to .env and fill in. .env is gitignored.

# Neon Postgres connection string, from the Neon console ->
# Connection Details. Use the POOLED string (the host contains "-pooler"):
# serverless functions cannot hold a normal connection pool open and would
# exhaust Neon's connection limit.
#
# Use a Neon dev branch locally and the primary branch in production, so both
# run the same Postgres with the same migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# console.anthropic.com -> API keys. Used only by the caption extractor.
# A few hundred extractions costs cents.
ANTHROPIC_API_KEY=""
