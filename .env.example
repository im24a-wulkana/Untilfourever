# Copy to .env and fill in. .env is gitignored.

# Neon Postgres connection string, from the Neon console ->
# Connection Details. Use the POOLED string (the host contains "-pooler"):
# serverless functions cannot hold a normal connection pool open and would
# exhaust Neon's connection limit.
#
# Use a Neon dev branch locally and the primary branch in production, so both
# run the same Postgres with the same migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# console.anthropic.com -> API keys. Used only by the caption extractor.
# A few hundred extractions costs cents.
ANTHROPIC_API_KEY=""

# Neon Auth — from the Neon console -> Auth -> Configuration.
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Stripe — dashboard.stripe.com -> Developers -> API keys.
# Use the test keys (sk_test_... / pk_test_...) until you are ready to charge.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` locally, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=""

# Public origin, used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
